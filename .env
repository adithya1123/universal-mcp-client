# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://oai-sandsub-oai-s-eastus-001.openai.azure.com/
AZURE_OPENAI_API_KEY="d29aa21d6b924719a948431536a935a5"
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Postgres Configuration (for Phase 2)
# Use asyncpg driver for SQLAlchemy async support
DATABASE_URL=postgresql+asyncpg://mcp_user:mcp_pass@localhost:5432/mcp_chat

# Application Configuration
DEBUG=true
LOG_LEVEL=INFO

# Rate Limiting Configuration
# Azure OpenAI rate limits (adjust based on your tier)
AZURE_OPENAI_MAX_RETRIES=5
AZURE_OPENAI_RETRY_MIN_WAIT=1
AZURE_OPENAI_RETRY_MAX_WAIT=60
# Token limits
MAX_TOKENS_PER_REQUEST=2000
MAX_CONVERSATION_HISTORY_MESSAGES=20
# Request throttling (milliseconds between API calls)
API_CALL_DELAY_MS=150
