# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT_NAME=""
AZURE_OPENAI_API_VERSION=""

# Postgres Configuration (for Phase 2)
# Use asyncpg driver for SQLAlchemy async support
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/db

# Application Configuration
DEBUG=true
LOG_LEVEL=INFO

# Port Configuration
# Change these if you need to use different ports
POSTGRES_PORT=5432
BACKEND_PORT=9000
FRONTEND_PORT=5173

# CORS Configuration
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Tool Execution Approval
# Set to "true" to require user approval before executing tools (human-in-the-loop)
REQUIRE_TOOL_APPROVAL=false
