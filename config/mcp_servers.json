{
  "servers": [
    {
      "name": "filesystem",
      "description": "Local filesystem access MCP server",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
      "enabled": true
    },
    {
      "name": "PostgreSql",
      "description": "PostgreSql data access MCP server",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql+asyncpg://mcp_user:mcp_pass@postgres:5432/mcp_chat"
      ],
      "enabled": true
    },
    {
      "name": "Weather",
      "description": "Live Weather data access MCP server",
      "transport": "stdio",
      "command": "/opt/homebrew/bin/uv",
      "args": ["--directory",
        "/Users/adithya/Desktop/LLM/mcp/weather",
        "run",
        "weather.py"],
      "enabled": false
    },
    {
      "name": "exa",
      "description": "Exa AI search MCP server",
      "transport": "http",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {},
      "enabled": true
    }
  ]
}
